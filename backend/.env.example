# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (docker-compose.yml bilan mos; host porti 5434)
DATABASE_URL=postgres://edulive:edulive_dev_pass@localhost:5434/edulive

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Fayllar
UPLOAD_DIR=./uploads

# Telegram bot — BITTA bot barcha maktablar uchun.
# Ota-ona /start <school_code> deep link orqali maktabga bog'lanadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=edulive_bot
# Webhook majburiy sir — bo'sh bo'lsa webhook o'chiq (fail-closed).
TELEGRAM_WEBHOOK_SECRET=

# Davomatni o'qituvchi necha soat ichida tahrirlay oladi (keyin menejer)
ATTENDANCE_EDIT_WINDOW_HOURS=3
