# Edge proxy — domen bo'yicha ajratadi va Let's Encrypt sertifikatini oladi.
# Ilova konteynerlari ichkarida oddiy :80 da ishlaydi (TLS shu yerda tugaydi).
# Xavfsizlik header'lari va CSP har bir ilovaning o'z Caddy'sidan keladi.
{
	email admin@edulive.uz
}

kassly.uz, www.kassly.uz {
	encode gzip zstd
	# `kassly-web` — kassly stack'ining `edge` tarmog'idagi taxallusi.
	# Deploy paytida konteyner qayta ishga tushadi — ulanishni uzish
	# o'rniga bir necha soniya kutamiz.
	reverse_proxy kassly-web:80 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

edulive.uz, www.edulive.uz {
	encode gzip zstd
	# Deploy paytida konteyner qayta ishga tushadi — ulanishni uzish
	# o'rniga bir necha soniya kutamiz.
	reverse_proxy edulive-web:80 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}
