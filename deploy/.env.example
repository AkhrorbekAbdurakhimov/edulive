# /opt/edulive/.env — production. Bu faylni HECH QACHON git'ga qo'ymang.

# Ommaviy domen (faqat hostname, https:// siz). Backend CORS shu bo'yicha
# ochiladi. TLS ni edge proxy beradi (/opt/proxy) — bu yerda ":80" yozilmaydi.
DOMAIN=edulive.uz

POSTGRES_USER=edulive
POSTGRES_PASSWORD=<uzun_tasodifiy_parol>
POSTGRES_DB=edulive

# GHCR image teglari. Orqaga qaytarish uchun :latest o'rniga commit SHA yozing.
BACKEND_IMAGE=ghcr.io/akhrorbekabdurakhimov/edulive-backend:latest
WEB_IMAGE=ghcr.io/akhrorbekabdurakhimov/edulive-web:latest

# openssl rand -hex 48
JWT_SECRET=<uzun_tasodifiy_satr>

# Bazadagi maxfiy qiymatlarni (maktablarning Telegram bot tokenlari)
# shifrlash kaliti. openssl rand -hex 32 — aynan 32 bayt.
# YO'QOTILSA ulangan botlar tokenlari ochilmaydi va qayta ulash kerak bo'ladi.
SECRET_KEY=<32_baytlik_hex>

# Telegram webhook manzilini yasash uchun (https bo'lishi shart).
PUBLIC_URL=https://edulive.uz
JWT_EXPIRES_IN=7d

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=edulive_bot
# openssl rand -hex 32 — bo'sh bo'lsa bot ishlamaydi (ataylab).
TELEGRAM_WEBHOOK_SECRET=

ATTENDANCE_EDIT_WINDOW_HOURS=3

# --- Xodimlar boti (@eduliveuz_bot) ------------------------------------
# Ota-onalar botidan ALOHIDA: egasi va ma'muriyatga kunlik hisobot,
# zaxira nusxa va muhim hodisalarni yuboradi.
# TELEGRAM_STAFF_SECRET — webhook manzilidagi maxfiy segment: openssl rand -hex 24
TELEGRAM_STAFF_TOKEN=
TELEGRAM_STAFF_USERNAME=eduliveuz_bot
TELEGRAM_STAFF_SECRET=

# --- SMS (Eskiz.uz) ----------------------------------------------------
# Qarz eslatmasi to'lamagan o'quvchining barcha raqamlariga ketadi.
# Bo'sh qoldirilsa SMS jimgina o'chiq bo'ladi — xato bermaydi.
#
# ESKIZ_SECRET — kabinetdagi "SMS API" maxfiy kodi, hisobga kirish paroli EMAS.
ESKIZ_EMAIL=
ESKIZ_SECRET=
# Eskizda tasdiqlangan jo'natuvchi nomi. 4546 — sinov niki: u bilan faqat
# oldindan tasdiqlangan sinov matni ketadi, haqiqiy eslatma RAD ETILADI.
ESKIZ_FROM=4546
# Yetkazilganlik xabari (DLR) manzilidagi maxfiy segment: openssl rand -hex 16
# Bo'sh bo'lsa DLR so'ralmaydi — "yuborildi" bor, "yetkazildi" bo'lmaydi.
ESKIZ_CALLBACK_SECRET=
